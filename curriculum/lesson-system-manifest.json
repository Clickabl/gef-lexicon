  "status_model": {
    "integrity_review_states": ["candidate", "approved", "superseded", "rejected"],
    "release_stages": ["machine_created", "machine_verified", "general_public", "education"],
    "release_order": ["machine_created", "machine_verified", "general_public", "education"],
    "public_beta_minimum": "machine_verified",
    "notes": "Integrity review and release readiness are independent dimensions. Schema validation or machine verification never changes review_state to approved."
  },
  "coverage_policy": {
    "language_registry_ref": "Clickabl/gef-expo/registry/language-support.json",
    "language_program_pointer": "/programs/learnFromLanguages",
    "counts_must_be_derived": true,
    "directional_pairs": true,
    "completeness_tiers": ["core", "full"],
    "core_all_language_invariant": "Every canonical vocabulary/concept required by a lesson part must have a resolvable lexicon realization or an explicit researched no-direct-equivalent record for every language in the canonical learn-from language program before that part may claim all-language Core coverage.",
    "tier3_core_policy": "Tier 3 targets may provide Core comparison, recognition-safe games, reader quests, and annotated-reading discovery when the required concept coverage exists. This does not make them full grammar-learning targets.",
    "full_grammar_policy": "Full grammar instruction is limited by the canonical language-support registry. At the current registry contract that means Tier 1 and selectively Tier 2, never Tier 3 merely because Core exists."
  },
  "component_catalog": [
    {"component_id":"lexicon_concepts","required_for":["core","full"],"notes":"Core cannot claim all-language coverage until every required concept resolves across the canonical learn-from program."},
    {"component_id":"intro_blurb","required_for":["core","full"]},
    {"component_id":"examples","required_for":["full"]},
    {"component_id":"ui_interactions","required_for":["core","full"]},
    {"component_id":"practice","required_for":["full"]},
    {"component_id":"game","required_for":["core","full"],"notes":"Core may use recognition-safe games even when production grammar practice is unavailable."},
    {"component_id":"quest","required_for":["core","full"]},
    {"component_id":"default_reading","required_for":["core","full"]},
    {"component_id":"annotations","required_for":["core","full"],"notes":"Corpus-side annotations live in gef-content and point back to lexicon concepts/lesson parts."},
    {"component_id":"related_lessons","required_for":["full"]},
    {"component_id":"learning_path","required_for":["core","full"]},
    {"component_id":"cefr_target","required_for":["core","full"]}
  ],
  "readiness_resolution": {
    "precedence": ["part_default", "tier_override", "source_language_override", "target_language_override", "pair_override"],
    "summary_is_derived": true,
    "pair_matrix_is_materialized": false,
    "notes": "Resolve each directional source-language to target-language view at read time. Exact pair overrides win. A dashboard may aggregate the resolved matrix, but generated summary rows are cache/projection data, never lesson truth. Any required component omitted from a readiness profile resolves as missing unless a more-specific override supplies it."
  },
