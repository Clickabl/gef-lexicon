{"schema_version":1,"lesson_family_id":"LES.mul.grammar.grammatical_gender","tier":3,"part":4,"review_state":"candidate","trust_state":"machine_translated","entries":[{"language_tag":"sw","system_type":"noun_class_system","system_badge":"N","gender_count":null,"gender_categories":["noun_classes"],"agreement_targets":["adjective","determiner","pronoun","numeral","verb"],"forms":[{"form_id":"CMP.sw.gender.1","display":"N","role":"larger noun-class agreement system"}],"note_en":"Swahili uses a larger noun-class agreement system rather than a masculine/feminine/neuter inventory.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"ha","system_type":"two","system_badge":"2","gender_count":2,"gender_categories":["masculine","feminine"],"agreement_targets":["adjective","determiner","pronoun","numeral"],"forms":[{"form_id":"CMP.ha.gender.1","display":"2","role":"2-gender agreement system"}],"note_en":"Hausa has masculine and feminine grammatical gender, with feminine singular commonly overtly distinguished.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"mr","system_type":"three","system_badge":"3","gender_count":3,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["adjective","determiner","pronoun","verb"],"forms":[{"form_id":"CMP.mr.gender.1","display":"3","role":"3-gender agreement system"}],"note_en":"Marathi has masculine, feminine and neuter grammatical gender with agreement.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"gu","system_type":"three","system_badge":"3","gender_count":3,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["adjective","determiner","pronoun","verb"],"forms":[{"form_id":"CMP.gu.gender.1","display":"3","role":"3-gender agreement system"}],"note_en":"Gujarati has masculine, feminine and neuter grammatical gender with agreement.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/index.html"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"ta","system_type":"three","system_badge":"3","gender_count":3,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["pronoun","verb"],"forms":[{"form_id":"CMP.ta.gender.1","display":"3","role":"3-gender agreement system"}],"note_en":"Tamil distinguishes masculine, feminine and neuter in the third-person agreement/pronominal system; gender is strongly tied to animacy and natural gender rather than arbitrary inanimate noun classes.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"te","system_type":"three","system_badge":"3","gender_count":3,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["pronoun","verb"],"forms":[{"form_id":"CMP.te.gender.1","display":"3","role":"3-gender agreement system"}],"note_en":"Telugu distinguishes masculine, feminine and neuter in third-person agreement; the system is semantically organized rather than an article-based noun-class system.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"ml","system_type":"limited","system_badge":"2+","gender_count":null,"gender_categories":["masculine","feminine","neuter_or_nonhuman"],"agreement_targets":["pronoun"],"forms":[{"form_id":"CMP.ml.gender.1","display":"2+","role":"complex or variable grammatical-gender system"}],"note_en":"Malayalam expresses gender distinctions especially in pronouns and animate reference, while ordinary adjective agreement is much more limited than in Romance or Slavic gender systems.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/ml.html"],"review_state":"candidate","trust_state":"machine_translated"}]}