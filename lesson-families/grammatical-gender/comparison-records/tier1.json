{"schema_version":1,"lesson_family_id":"LES.mul.grammar.grammatical_gender","tier":1,"review_state":"candidate","trust_state":"machine_translated","entries":[{"language_tag":"en","system_type":"limited","system_badge":"∅","gender_count":0,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["pronoun"],"forms":[{"form_id":"CMP.en.gender.1","display":"he / she / it","role":"third-person pronoun contrast"}],"note_en":"Ordinary English nouns do not participate in a productive noun-gender agreement system; gender survives mainly in pronouns and lexical meaning. WALS uses a broader agreement definition that can count English pronominal genders.","source_refs":["https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"es","system_type":"two","system_badge":"2","gender_count":2,"gender_categories":["masculine","feminine"],"agreement_targets":["article","determiner","adjective","pronoun","numeral"],"forms":[{"form_id":"CMP.es.gender.1","display":"el","role":"masculine singular definite article"},{"form_id":"CMP.es.gender.2","display":"la","role":"feminine singular definite article"}],"note_en":"Spanish ordinary nouns are masculine or feminine. Neuter lo/esto/eso/aquello are limited neuter forms, not a third ordinary noun gender.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/index.html","https://wals.info/chapter/30"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"fr","system_type":"two","system_badge":"2","gender_count":2,"gender_categories":["masculine","feminine"],"agreement_targets":["article","determiner","adjective","pronoun"],"forms":[{"form_id":"CMP.fr.gender.1","display":"le","role":"masculine singular definite article"},{"form_id":"CMP.fr.gender.2","display":"la","role":"feminine singular definite article"}],"note_en":"French has masculine and feminine noun gender; l’ can hide the article contrast before vowels.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/index.html"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"pt","system_type":"two","system_badge":"2","gender_count":2,"gender_categories":["masculine","feminine"],"agreement_targets":["article","determiner","adjective","pronoun","numeral"],"forms":[{"form_id":"CMP.pt.gender.1","display":"o","role":"masculine singular definite article"},{"form_id":"CMP.pt.gender.2","display":"a","role":"feminine singular definite article"}],"note_en":"Portuguese has masculine and feminine noun gender with agreement on articles, many determiners and adjectives.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/index.html"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"it","system_type":"two","system_badge":"2","gender_count":2,"gender_categories":["masculine","feminine"],"agreement_targets":["article","determiner","adjective","pronoun","numeral"],"forms":[{"form_id":"CMP.it.gender.1","display":"il","role":"one masculine singular definite article"},{"form_id":"CMP.it.gender.2","display":"la","role":"feminine singular definite article"}],"note_en":"Italian has masculine and feminine noun gender. Multiple article allomorphs mean article-form count is not gender count.","source_refs":["https://www.unicode.org/cldr/charts/46.1/grammar/index.html"],"review_state":"candidate","trust_state":"machine_translated"},{"language_tag":"el","system_type":"three","system_badge":"3","gender_count":3,"gender_categories":["masculine","feminine","neuter"],"agreement_targets":["article","determiner","adjective","pronoun","numeral","case"],"forms":[{"form_id":"CMP.el.gender.1","display":"ο","role":"masculine nominative singular article"},{"form_id":"CMP.el.gender.2","display":"η","role":"feminine nominative singular article"},{"form_id":"CMP.el.gender.3","display":"το","role":"neuter nominative singular article"}],"note_en":"Modern Greek has masculine, feminine and neuter noun genders,