export type EntityReviewState = 'candidate' | 'approved' | 'superseded' | 'rejected';
export type EntityTranslationState = 'source' | 'machine_translation' | 'human_translation';
export type EntityType = 'person'|'real_person'|'historical_person'|'fictional_character'|'mythological_figure'|'organization'|'collective_creator'|'cultural_attribution'|'traditional_attribution'|'anonymous_attribution'|'unknown_attribution'|'publisher_attribution'|'publisher'|'place'|'country'|'geographic_region'|'literary_period'|'genre'|'literary_category'|'content_type'|'tradition'|'calendar'|'language'|'script'|'literary_movement'|'occupation'|'other';
export type EntitySourceProvenance = Readonly<{repository:'gef-lexicon'|'gef-content'|'gef-expo';path:string;revision_sha:string;field?:string;source_review_state?:string}>;
export type EntityEvidence = Readonly<{review_state:EntityReviewState;source_refs:readonly string[];source_provenance?:EntitySourceProvenance}>;
export type EntityLabel = EntityEvidence & Readonly<{label_id:string;text:string;language_tag?:string;script?:string;name_type:'canonical'|'original_script'|'localized'|'transliteration'|'romanization'|'pseudonym'|'historical'|'alias';translation_state:EntityTranslationState}>;
export type EntityBiography = EntityEvidence & Readonly<{biography_id:string;language_tag:string;short_text?:string;long_text?:string;work_id?:string;translation_state:EntityTranslationState}>;
export type BibliographicEvidence = Readonly<{citation:string;url?:string;source_id?:string;locator?:string}>;
export type BibliographicDateValue = Readonly<{year?:number;date?:string;earliest_year?:number;latest_year?:number}>;
export type BibliographicDateFact = Readonly<{certainty:'known'|'approximate'|'unknown'|'disputed';value?:BibliographicDateValue;alternatives?:readonly Readonly<{value?:BibliographicDateValue;evidence:readonly BibliographicEvidence[];source_calendar_entity_id?:string;source_notation?:string;source_precision?:'year'|'month'|'day'|'range'}>[];evidence:readonly BibliographicEvidence[];notes?:string;source_calendar_entity_id?:string;source_notation?:string;source_precision?:'year'|'month'|'day'|'range';normalized_gregorian_value?:BibliographicDateValue;conversion_evidence?:readonly BibliographicEvidence[]}>;
export type EntityRelationshipKind = 'birthplace'|'death_place'|'associated_country'|'citizenship'|'cultural_origin'|'language_of_work'|'literary_movement'|'occupation'|'member_of'|'attributed_tradition';
export type EntityRelationship = EntityEvidence & Readonly<{relationship_id:string;kind:EntityRelationshipKind;target_entity_id:string;certainty:'known'|'approximate'|'unknown'|'disputed';period?:Readonly<{start?:BibliographicDateFact;end?:BibliographicDateFact}>;historical_context?:Readonly<{text:string;language_tag?:string}>}>;
export type CanonicalEntity = EntityEvidence & Readonly<{entity_id:string;entity_type:EntityType;canonical_name:string;canonical_name_language_tag?:string;names:readonly EntityLabel[];biographies:readonly EntityBiography[];external_ids:Readonly<Record<string,readonly string[]>>;legacy_ids:readonly string[];created_at:string;updated_at:string;research_notes?:string;birth_date?:string|null;death_date?:string|null;birth?:BibliographicDateFact;death?:BibliographicDateFact;relationships?:readonly EntityRelationship[]}>;
export type EntityRedirect = Readonly<{from_entity_id:string;to_entity_id:string;created_at:string;source_refs:readonly string[];reason?:string}>;
export type EntityRegistry = Readonly<{schema_version:2;contract:'gef-entity-registry-v1';revision:number;entities:readonly CanonicalEntity[];redirects:readonly EntityRedirect[]}>;
export const ENTITY_REGISTRY_CONTRACT:'gef-entity-registry-v1';
export const ENTITY_REGISTRY_LIMITS:Readonly<{entities:number;labels:number;biographies:number;relationships:number;textBytes:number;sourceBytes:number;publicBytes:number;sqliteBytes:number}>;
export const ENTITY_TYPES:readonly EntityType[];
export const ENTITY_RELATIONSHIP_KINDS:readonly EntityRelationshipKind[];
export const ENTITY_RELATIONSHIP_TARGET_TYPES:Readonly<Record<EntityRelationshipKind,readonly EntityType[]>>;
export function validateEntityRegistry(input:unknown,options?:Readonly<{bibliography?:Readonly<{sources:readonly Readonly<{source_id:string}>[]}>}>):EntityRegistry;
export function resolveEntityId(registry:EntityRegistry,value:string):string|undefined;
export function resolveEntityName(entity:CanonicalEntity,languageTag?:string,options?:Readonly<{mode?:'beta'|'reviewed';defaultRepresentations?:Readonly<Record<string,string>>}>):Readonly<{text:string;language_tag?:string;label_id?:string;review_state:EntityReviewState;translation_state:EntityTranslationState;source_refs:readonly string[]}>;
export function resolveEntityBiography(entity:CanonicalEntity,languageTag?:string,options?:Readonly<{mode?:'beta'|'reviewed';defaultRepresentations?:Readonly<Record<string,string>>;workId?:string;kind?:'short'|'long'}>):Readonly<{text:string;language_tag:string;biography_id:string;review_state:EntityReviewState;translation_state:EntityTranslationState;source_refs:readonly string[];work_id?:string}>|undefined;
export function normalizeEntitySearch(text:string):string;
export function searchEntities(registry:EntityRegistry,query:string,options?:Readonly<{mode?:'beta'|'reviewed';defaultRepresentations?:Readonly<Record<string,string>>;limit?:number;entityType?:EntityType}>):readonly Readonly<{entity_id:string;entity_type:EntityType;matched_name:string;matched_source_entity_id:string;matched_review_state:EntityReviewState;language_tag?:string;rank:number}>[];
export function publicEntityRegistry(registry:EntityRegistry):EntityRegistry;
export function entityWritingRepresentationCompatible(requestedTag:string,actualTag:string,actualScript?:string,defaultRepresentations?:Readonly<Record<string,string>>):boolean;

export type PublicEntityCitation = Readonly<{source_id:string;source_type:string;title:string;author?:string;creator?:string;publisher?:string;year?:number|null;release_date?:string;language?:string;region?:string;url?:string;official_url?:string;license?:string;parent_source_id?:string;edition_context?:Readonly<{locale?:string;channel?:'original_text'|'original_dialogue'|'script'|'transcript'|'subtitle'|'dub'|'published_translation'|'caption'|'other';platform_or_release?:string}>;external_ids?:Readonly<Record<string,string>>;source_kind?:string;source_publication?:string;source_date?:string;institution?:string;identifier?:string;pages?:string;locator?:string;transcript_url?:string;transcript_urls?:readonly string[]}>;
export type PublicEntitySources = Readonly<{contract:'gef-entity-sources-v1';sources:readonly PublicEntityCitation[]}>;
export const PUBLIC_ENTITY_SOURCE_FIELDS:readonly (keyof PublicEntityCitation)[];
export const PUBLIC_ENTITY_SOURCE_TYPES:readonly string[];
export function validatePublicEntitySources(input:unknown,options?:Readonly<{registry?:EntityRegistry}>):PublicEntitySources;

export function publicEntitySources(registry:EntityRegistry,bibliography:Readonly<{sources:readonly Readonly<Record<string,unknown> & {source_id:string}>[]}>):PublicEntitySources;
