    {
      "note_id": "same_spelling_different_meaning",
      "kind": "false_friend",
      "text": "A few Turkish words are spelled exactly like English ones but mean something else. It is pure coincidence, not a shared root, so read them as Turkish words.",
      "pairs": [
        {"from": "at", "to": "at", "to_ipa": "at", "to_meaning": "a horse"},
        {"from": "bin", "to": "bin", "to_ipa": "bin", "to_meaning": "a thousand"},
        {"from": "ham", "to": "ham", "to_ipa": "ham", "to_meaning": "raw, unripe"},
        {"from": "pasta", "to": "pasta", "to_ipa": "pasˈta", "to_meaning": "cake, pastry"},
        {"from": "son", "to": "son", "to_ipa": "son", "to_meaning": "last, the end"},
        {"from": "ten", "to": "ten", "to_ipa": "ten", "to_meaning": "skin"}
      ]
