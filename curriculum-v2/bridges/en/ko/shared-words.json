    {
      "note_id": "konglish_false_friends",
      "kind": "false_friend",
      "text": "A few English words came into Korean and changed their meaning. If you guess from the English, you will be wrong. These are the ones that catch people out.",
      "pairs": [
        {
          "from": "fighting",
          "to": "파이팅",
