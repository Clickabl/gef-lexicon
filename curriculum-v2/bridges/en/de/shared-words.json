        {"from": "finger", "to": "Finger", "to_ipa": "ˈfɪŋɐ"},
        {"from": "winter", "to": "Winter", "to_ipa": "ˈvɪntɐ"},
        {"from": "milk", "to": "Milch", "to_ipa": "mɪlç"},
