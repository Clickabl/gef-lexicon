        {"from": "water", "to": "Wasser", "to_ipa": "ˈvasɐ"},
        {"from": "hand", "to": "Hand", "to_ipa": "hant"},
        {"from": "house", "to": "Haus", "to_ipa": "haʊ̯s"},
        {"from": "book", "to": "Buch", "to_ipa": "buːx"},
        {"from": "apple", "to": "Apfel", "to_ipa": "ˈapfəl"},
        {"from": "father", "to": "Vater", "to_ipa": "ˈfaːtɐ"},
        {"from": "mother", "to": "Mutter", "to_ipa": "ˈmʊtɐ"},
