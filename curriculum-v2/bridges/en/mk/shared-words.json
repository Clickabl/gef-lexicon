        {"from": "son", "to": "сон", "to_ipa": "sɔn", "to_meaning": "a dream, sleep"},
        {"from": "list", "to": "лист", "to_ipa": "list", "to_meaning": "a leaf, a sheet of paper"},
        {"from": "red", "to": "ред", "to_ipa": "rɛt", "to_meaning": "a row, a line, a turn"}
