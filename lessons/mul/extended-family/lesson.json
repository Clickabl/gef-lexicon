    {"rule_id":"RULE.mul.family.extended.relationship_path","rule_key":"resolve-the-relationship-path-first","order":1,"match_refs":[],"practice_eligible_by_default":true,"notes":"Identify the genealogical or affinity path before choosing a surface term: parent's parent, parent's sibling, sibling's child, cousin, spouse's parent, and so on."},
