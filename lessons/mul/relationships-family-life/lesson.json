  "rules": [
    {"rule_id":"RULE.mul.family.relationships.status","rule_key":"relationship-status-words-name-different-kinds-of-facts","order":1,"match_refs":[],"practice_eligible_by_default":true,"notes":"Dating, engaged, married, separated, divorced, widowed and single describe different relationship or legal/social states; do not flatten them into one continuum."},
    {"rule_id":"RULE.mul.family.relationships.labels","rule_key":"speaker-chosen-relationship-label-wins","order":2,"match_refs":[],"practice_eligible_by_default":true,"notes":"Boyfriend, girlfriend, partner, spouse, husband, wife and significant other carry different gender, marriage and register signals. Teach conventional meaning without overriding a person's chosen label."},
