{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/name.schema.json",
  "title": "GEF Name Family Database",
  "type": "object",
  "required": ["schema_version", "language_code", "names"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "language_code": {"type": "string"},
    "names": {"type": "array", "items": {"$ref": "#/definitions/name"}}
  },
  "definitions": {
    "name": {
      "type": "object",
      "required": ["name_id", "canonical_form", "name_type", "spellings", "review_state"],
      "properties": {
        "name_id": {"type": "string", "pattern": "^name_[A-Za-z0-9._:-]+$"},
        "canonical_form": {"type": "string"},
        "name_type": {"type": "string", "enum": ["given", "family", "patronymic", "matronymic", "title", "epithet", "mononym", "other"]},
        "spellings": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/spelling"}},
        "related_names": {"type": "array", "items": {"$ref": "#/definitions/nameRelation"}},
        "gender_usage": {"type": "array", "items": {"$ref": "#/definitions/genderUsage"}},
        "etymology_note": {"type": "string"},
        "historical_note": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]}
      }
    },
    "spelling": {
      "type": "object",
      "required": ["text", "status"],
      "properties": {
        "text": {"type": "string"},
        "status": {"type": "string", "enum": ["canonical", "variant", "historical", "transliteration"]},
        "script": {"type": "string"},
        "locale": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "nameRelation": {
      "type": "object",
      "required": ["target_name_id", "relation_type"],
      "properties": {
        "target_name_id": {"type": "string"},
        "relation_type": {"type": "string", "enum": ["variant_family", "cognate", "diminutive", "augmentative", "derived_from", "related"]},
        "note": {"type": "string"}
      }
    },
    "genderUsage": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "region": {"type": "string"},
        "period_start": {"type": "integer"},
        "period_end": {"type": "integer"},
        "male_share": {"type": "number", "minimum": 0, "maximum": 1},
        "female_share": {"type": "number", "minimum": 0, "maximum": 1},
        "nonbinary_or_other_share": {"type": "number", "minimum": 0, "maximum": 1},
        "unknown_share": {"type": "number", "minimum": 0, "maximum": 1},
        "sample_size": {"type": "integer", "minimum": 0},
        "source_id": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  }
}
