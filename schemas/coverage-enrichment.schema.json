{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/coverage-enrichment.schema.json",
  "title": "GEF Source Vocabulary Coverage Enrichment",
  "description": "Candidate staging data used to ensure every source surface is semantically routed before promotion into rich lexicon/name/entity records. This file is not a production dictionary.",
  "type": "object",
  "required": ["schema_version", "language_code", "batch_id", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "language_code": {"type": "string"},
    "batch_id": {"type": "string"},
    "source_work_ids": {"type": "array", "items": {"type": "string"}},
    "records": {"type": "array", "items": {"$ref": "#/definitions/record"}}
  },
  "definitions": {
    "record": {
      "type": "object",
      "required": ["lemma", "attested_surfaces", "route", "review_state"],
      "properties": {
        "lemma": {"type": "string"},
        "attested_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "route": {"type": "string", "enum": ["core_lexeme", "book_lexeme", "name", "entity", "number", "punctuation_or_nonlexical", "needs_disambiguation"]},
        "upos_candidates": {"type": "array", "items": {"type": "string"}},
        "definition_en": {"type": "string"},
        "notes": {"type": "string"},
        "target_ids": {"type": "array", "items": {"type": "string"}},
        "review_state": {"type": "string", "enum": ["candidate", "reviewed", "superseded", "rejected"]}
      }
    }
  }
}
