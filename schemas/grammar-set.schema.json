{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/grammar-set.schema.json",
  "title": "Gef reusable multilingual grammar set",
  "type": "object",
  "required": ["schema_version", "grammar_set_id", "anchor", "languages", "review_state", "version"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "grammar_set_id": {"type": "string", "pattern": "^GRAMSET\\.[A-Za-z0-9._-]+$"},
    "anchor": {
      "type": "object",
      "required": ["language_tag", "surface"],
      "properties": {
        "language_tag": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "lesson_family_id": {"type": "string", "pattern": "^LES\\.[A-Za-z0-9._-]+$"},
    "scope_note": {"type": "string"},
    "languages": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/language"}},
    "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
    "version": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "summary_en", "tips_en"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^RULE\\.[A-Za-z0-9._-]+$"},
        "summary_en": {"type": "string", "minLength": 1},
        "semantic_function_ids": {"type": "array", "items": {"type": "string", "pattern": "^SEM\\.[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "tips_en": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": ["form_id", "display", "form_kind", "rules"],
      "properties": {
        "form_id": {"type": "string", "pattern": "^GRAMFORM\\.[A-Za-z0-9._-]+$"},
        "display": {"type": "string", "minLength": 1},
        "form_kind": {"type": "string", "enum": ["word", "preposition", "postposition", "case_marker", "particle", "prepositional_phrase", "construction", "clause_marker", "other"]},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/rule"}}
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": ["language_tag", "classification", "lesson_ready", "forms", "review_state"],
      "properties": {
        "language_tag": {"type": "string", "minLength": 1},
        "language_name_en": {"type": "string"},
        "classification": {"type": "string", "enum": ["anchor", "multi_form", "multi_construction", "single_dominant_form", "research_required"]},
        "lesson_ready": {"type": "boolean"},
        "forms": {"type": "array", "items": {"$ref": "#/definitions/form"}},
        "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
