{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/concept.schema.json",
  "title": "Global Interlingual Concept Graph",
  "type": "object",
  "required": ["schema_version", "concepts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "concept_key", "domain", "senses_by_language"],
        "properties": {
          "concept_id": { "type": "string" },
          "concept_key": { "type": "string" },
          "domain": { "type": "string" },
          "cefr_estimate": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
          "senses_by_language": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
