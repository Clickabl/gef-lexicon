{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/concept.schema.json",
  "title": "Global Interlingual Concept Manifest",
  "type": "object",
  "required": ["schema_version", "concepts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "concept_key", "domain"],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^cpt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "concept_key": { "type": "string" },
          "domain": { "type": "string" },
          "planning_difficulty_hint": {
            "type": "string",
            "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
          }
        }
      }
    }
  }
}
