{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gef.clickabl.co/schemas/lesson-lexi-integration.schema.json",
  "title": "Gef lesson Lexi integration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_id", "lesson_id", "domains", "artifacts", "surfaces", "review_state", "version"],
  "properties": {
    "schema_version": {"const": 1},
    "integration_id": {"type": "string", "pattern": "^LEXI\\.LESSON\\."},
    "lesson_id": {"type": "string", "pattern": "^LES\\."},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "role"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "related_integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "relationship"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_state": {"enum": ["candidate", "approved", "superseded", "rejected"]},
    "notes": {"type": "string"},
    "version": {"type": "integer", "minimum": 1}
  }
}
