{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/lexicon-entry.schema.json",
  "title": "Lexicon Entry (Lexeme & Senses)",
  "description": "Cross-linguistic schema for Gef & Clickabl lexemes, incorporating UniMorph/UD feature layers, form-vs-analysis separation, and distractor/quiz graph relationships.",
  "type": "object",
  "required": ["lexeme_id", "lemma_nfc", "upos", "review_state", "senses"],
  "properties": {
    "lexeme_id": {
      "type": "string",
      "description": "UUIDv7 opaque ID."
    },
    "lemma_nfc": {
      "type": "string",
      "description": "Dictionary headword in Unicode NFC form."
    },
    "upos": {
      "type": "string",
      "enum": ["NOUN", "VERB", "ADJ", "ADV", "PRON", "DET", "ADP", "NUM", "CONJ", "CCONJ", "SCONJ", "PART", "INTJ", "PROPN", "PUNCT", "SYM", "X"],
      "description": "Universal Part of Speech tag."
    },
    "language_pos": {
      "type": "string",
      "description": "Language-specific POS classification (e.g. classifier, particle-aspect, verb-auxiliary, honorific-noun)."
    },
    "lexical_features": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "proper_noun": {
      "type": "boolean",
      "default": false,
      "description": "True for character names, places, invented terms. Excluded from CEFR vocabulary density calculations."
    },
    "review_state": {
      "type": "string",
      "enum": ["candidate", "approved", "superseded", "rejected"]
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sense" }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/wordForm" }
    }
  },
  "definitions": {
    "sense": {
      "type": "object",
      "required": ["sense_id", "sense_key", "definitions"],
      "properties": {
        "sense_id": { "type": "string", "description": "UUIDv7." },
        "sense_key": { "type": "string", "description": "Stable slug unique to this lexeme." },
        "primary_concept_id": { "type": ["string", "null"], "description": "Link to global concept in concepts/graph.json." },
        "definitions": {
          "type": "object",
          "description": "Map of interface language (en, es, fr, pt, it, el) to definition string.",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "sense_hint": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cefr_level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },
        "register_label": { "type": "string" },
        "homophones": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Words/lexemes with identical pronunciation."
        },
        "homonyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Words/senses with identical spelling but different meaning."
        },
        "synonyms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "antonyms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confusable_senses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sense IDs or terms used to generate distractor choices in language learning quizzes."
        }
      }
    },
    "wordForm": {
      "type": "object",
      "required": ["form_id", "surface_nfc", "analyses"],
      "properties": {
        "form_id": { "type": "string" },
        "surface_nfc": { "type": "string" },
        "normalized_lookup": { "type": "string" },
        "attested_in_text": { "type": "boolean", "default": false },
        "analyses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/formAnalysis" }
        }
      }
    },
    "formAnalysis": {
      "type": "object",
      "required": ["analysis_id", "features"],
      "properties": {
        "analysis_id": { "type": "string" },
        "features": {
          "type": "object",
          "required": ["base"],
          "properties": {
            "base": {
              "type": "object",
              "properties": {
                "tense": { "type": "string" },
                "aspect": { "type": "string" },
                "mood": { "type": "string" },
                "voice": { "type": "string" },
                "person": { "type": "string" },
                "number": { "type": "string" },
                "gender": { "type": "string" },
                "case": { "type": "string" },
                "degree": { "type": "string" },
                "definiteness": { "type": "string" },
                "non_finite": { "type": "string" },
                "politeness": { "type": "string", "enum": ["plain", "polite", "formal", "honorific", "humble"] }
              },
              "additionalProperties": { "type": "string" }
            },
            "possessor": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "subject": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "object": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "clitic": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": { "type": "object" }
        },
        "display_label_key": { "type": "string" }
      }
    }
  }
}
