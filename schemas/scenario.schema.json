{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/scenario.schema.json",
  "title": "Gef Learning Scenario",
  "description": "An authored communicative or story situation that composes canonical learning targets and activities without redefining linguistic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_key",
    "title_key",
    "summary_key",
    "target_refs",
    "activity_kinds",
    "review_state",
    "version"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "scenario_id": {"type": "string", "pattern": "^SCENARIO\\.[A-Za-z0-9._-]+$"},
    "scenario_key": {"type": "string", "minLength": 1},
    "title_key": {"type": "string", "minLength": 1},
    "summary_key": {"type": "string", "minLength": 1},
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/targetRef"}
    },
    "optional_target_refs": {
      "type": "array",
      "items": {"$ref": "#/definitions/targetRef"}
    },
    "activity_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["explanation", "lesson", "practice", "game", "quest", "story_transfer"]
      }
    },
    "discovery_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "difficulty_band": {
      "type": "string",
      "enum": ["pre_a1", "A1", "A2", "B1", "B2", "C1", "C2", "mixed"]
    },
    "notes": {"type": "string"},
    "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
    "version": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["topic", "lexeme", "sense", "construction", "semantic_function"]
        },
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["required", "supporting", "contrast", "transfer"]}
      }
    }
  }
}
