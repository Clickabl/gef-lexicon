{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/instructional-note-renderings.schema.json",
  "title": "Gef instructional note renderings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "language_tag", "renderings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract": {"type": "string", "const": "gef-instructional-note-renderings-v1"},
    "language_tag": {"type": "string", "minLength": 1},
    "renderings": {
      "type": "array",
      "items": {"$ref": "#/definitions/rendering"}
    }
  },
  "definitions": {
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_id", "body", "review_state"],
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "body": {"type": "string", "minLength": 1},
        "action_label": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_state": {
          "type": "string",
          "enum": ["candidate", "approved", "superseded", "rejected"]
        }
      }
    }
  }
}
