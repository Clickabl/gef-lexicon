{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/sense-card-v1.schema.json",
  "title": "GEF reusable Sense Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sense_id", "lexeme_id", "language_code", "headword", "part_of_speech", "localization", "readiness"],
  "properties": {
    "schema_version": {"const": 1},
    "sense_id": {"type": "string", "minLength": 1},
    "lexeme_id": {"type": "string", "minLength": 1},
    "language_code": {"type": "string", "minLength": 2},
    "headword": {"type": "string", "minLength": 1},
    "part_of_speech": {"type": "string", "minLength": 1},
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cefr_level": {"type": "string"},
        "gef_level": {"type": "number", "minimum": 0, "maximum": 7}
      }
    },
    "pronunciations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ipa"],
        "properties": {
          "ipa": {"type": "string", "minLength": 1},
          "locale": {"type": "string"},
          "notation": {"type": "string", "enum": ["phonemic", "phonetic"]}
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_language", "definition"],
      "properties": {
        "interface_language": {"type": "string", "minLength": 2},
        "gloss": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "hint": {"type": "string", "minLength": 1}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "text"],
      "properties": {
        "example_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "translation": {"type": "string", "minLength": 1}
      }
    },
    "concept_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "relationship"],
        "properties": {
          "concept_id": {"type": "string"},
          "relationship": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "same_lexeme_other_sense_ids": {"type": "array", "items": {"type": "string"}},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookup_ready", "quiz_ready", "daily_ready", "reasons"],
      "properties": {
        "lookup_ready": {"type": "boolean"},
        "quiz_ready": {"type": "boolean"},
        "daily_ready": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
