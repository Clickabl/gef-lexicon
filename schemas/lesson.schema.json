{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/lesson.schema.json",
  "title": "GEF Reusable Lesson",
  "type": "object",
  "required": ["schema_version", "lesson_id", "lesson_key", "target_language", "difficulty_band", "rules", "triggers", "practice_modules", "review_state", "version"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2, 3, 4]},
    "lesson_id": {"type": "string", "pattern": "^LES\\.[A-Za-z0-9._-]+$"},
    "lesson_key": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "minLength": 1},
    "curriculum_concept_ids": {"type": "array", "items": {"type": "string"}},
    "construction_ids": {"type": "array", "items": {"type": "string", "pattern": "^CTR\\.[A-Za-z0-9._-]+$"}},
    "prerequisite_lesson_ids": {"type": "array", "items": {"type": "string", "pattern": "^LES\\.[A-Za-z0-9._-]+$"}},
    "difficulty_band": {"type": "string", "enum": ["pre-A1", "A1", "A2", "B1", "B2", "C1", "C2", "mixed"]},
    "grammar_set_id": {"type": "string", "pattern": "^GRAMSET\\.[A-Za-z0-9._-]+$"},
    "knowledge_set_id": {"type": "string", "pattern": "^KNOWSET\\.[A-Za-z0-9._-]+$"},
    "knowledge_set_source": {"type": "string", "minLength": 1},
    "language_capabilities_manifest": {"type": "string", "minLength": 1},
    "session_policy": {"$ref": "#/definitions/sessionPolicy"},
    "rules": {"type": "array", "items": {"$ref": "#/definitions/rule"}},
    "triggers": {"type": "array", "items": {"$ref": "#/definitions/trigger"}},
    "practice_modules": {"type": "array", "items": {"$ref": "#/definitions/practiceModule"}},
    "game_exports": {"type": "array", "items": {"type": "object"}},
    "example_query": {"$ref": "#/definitions/exampleQuery"},
    "presentation": {"type": "object"},
    "interaction_defaults": {
      "type": "object",
      "properties": {
        "offer_mode": {"type": "string", "enum": ["tap_sheet", "manual_lessons_tab", "lesson_catalog", "learning_mode_preflight", "restrained_contextual_offer", "queued_story_knot"]},
        "dismissal_behavior": {"type": "string"},
        "cooldown_policy": {"type": "string"},
        "language_limit": {"type": "integer", "minimum": 1},
        "teacher_quest_default": {"type": "string", "enum": ["hidden", "optional", "required"]}
      },
      "additionalProperties": false
    },
    "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
    "trust_state": {"type": "string", "enum": ["machine_translated", "machine_verified", "public", "gef_certified"]},
    "version": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "typedRef": {
      "type": "object",
      "required": ["target_type", "target_id"],
      "properties": {
        "target_type": {"type": "string", "enum": ["lexeme", "sense", "form", "analysis", "phrase_pattern", "semantic_function", "construction", "concept", "name_family", "name_form", "name", "entity"]},
        "target_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sessionPolicy": {
      "type": "object",
      "required": ["minimum_display_languages", "maximum_display_languages", "prefer_profile_languages", "language_selection_is_session_only", "display_modes"],
      "properties": {
        "minimum_display_languages": {"type": "integer", "minimum": 1},
        "maximum_display_languages": {"type": "integer", "minimum": 1},
        "fixed_comparison_language_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prefer_profile_languages": {"type": "boolean"},
        "fallback_language_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "requires_at_least_one_non_anchor_multi_language": {"type": "boolean"},
        "language_selection_is_session_only": {"type": "boolean"},
        "language_roles_are_distinct": {"type": "boolean"},
        "dedupe_display_without_losing_roles": {"type": "boolean"},
        "display_modes": {"type": "array", "items": {"enum": ["scroll", "pages", "presentation"]}, "uniqueItems": true},
        "practice_mode": {"enum": ["always", "only_when_selected_languages_have_meaningful_choice", "learning_languages_with_full_lesson_support_only", "none"]},
        "full_lesson_target_policy": {"type": "string"},
        "tier3_target_policy": {"type": "string"},
        "comparison_only_mode": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "rule_key", "order", "match_refs"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^RULE\\.[A-Za-z0-9._-]+$"},
        "rule_key": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "semantic_function_ids": {"type": "array", "items": {"type": "string", "pattern": "^SEM\\.[A-Z0-9._-]+$"}},
        "construction_ids": {"type": "array", "items": {"type": "string", "pattern": "^CTR\\.[A-Za-z0-9._-]+$"}},
        "match_refs": {"type": "array", "items": {"$ref": "#/definitions/typedRef"}},
        "practice_eligible_by_default": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["trigger_id", "trigger_type"],
      "properties": {
        "trigger_id": {"type": "string", "pattern": "^TRG\\.[A-Za-z0-9._-]+$"},
        "trigger_type": {"type": "string", "enum": ["tap", "repeated_encounter", "passage", "pattern", "morphology", "manual", "learning_mode_preflight", "profile_event", "catalog_topic"]},
        "match_any": {"type": "array", "items": {"$ref": "#/definitions/typedRef"}},
        "feature_bundle": {"type": "object"},
        "minimum_encounters": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "practiceModule": {
      "type": "object",
      "required": ["module", "eligible_rule_ids"],
      "properties": {
        "module": {"type": "string", "enum": ["inline_choice_cloze", "typed_cloze", "meaning_here", "find_in_sentence", "why_this", "form_to_features", "features_to_form", "conjugation_slot", "pattern_hunt", "compare_realizations", "name_family_map", "name_form_match", "personal_name_explorer", "ordered_sequence", "concept_term_match", "cycle_neighbor", "reader_quest"]},
        "eligible_rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^RULE\\.[A-Za-z0-9._-]+$"}},
        "choice_refs": {"type": "array", "items": {"$ref": "#/definitions/typedRef"}},
        "constraints": {"type": "object"}
      },
      "additionalProperties": false
    },
    "exampleQuery": {
      "type": "object",
      "properties": {
        "prefer_current_book": {"type": "boolean"},
        "max_book_examples": {"type": "integer", "minimum": 0},
        "spoiler_policy": {"type": "string", "enum": ["current_then_read", "read_only", "reviewed_generic"]},
        "minimum_quality": {"type": "string", "enum": ["usable", "good", "excellent"]},
        "require_reviewed_occurrence": {"type": "boolean"},
        "prefer_current_book_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "prefer_quotes_across_world_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "fallback_to_global_lesson_safe_pool": {"type": "boolean"},
        "maximum_intro_examples_per_rule": {"type": "integer", "minimum": 0},
        "practice_avoids_previously_shown_examples": {"type": "boolean"},
        "require_lesson_safe": {"type": "boolean"},
        "require_spoiler_safe": {"type": "boolean"},
        "allow_teacher_pinned_examples": {"type": "boolean"},
        "teacher_pins_win_over_random_selection": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
