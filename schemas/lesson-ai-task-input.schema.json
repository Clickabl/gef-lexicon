{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/lesson-ai-task-input.schema.json",
  "title": "Gef lesson component AI task input",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson_group_id", "part_id", "source_language", "target_language", "completeness_tier", "component", "desired_release_stage", "signals", "canonical_refs"],
  "properties": {
    "lesson_group_id": {"type": "string", "pattern": "^GROUP\\.[A-Za-z0-9._-]+$"},
    "part_id": {"type": "string", "pattern": "^PART\\.[A-Za-z0-9._-]+$"},
    "source_language": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "minLength": 1},
    "completeness_tier": {"enum": ["core", "full"]},
    "component": {"enum": ["lexicon_concepts", "intro_blurb", "examples", "ui_interactions", "practice", "game", "quest", "default_reading", "annotations", "related_lessons", "learning_path", "cefr_target"]},
    "desired_release_stage": {"enum": ["machine_created", "machine_verified", "general_public", "education"]},
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent_signup_demand", "active_learner_demand", "path_criticality", "readiness_gap", "coverage_gap", "staleness", "estimated_cost"],
      "properties": {
        "recent_signup_demand": {"type": "number", "minimum": 0},
        "active_learner_demand": {"type": "number", "minimum": 0},
        "path_criticality": {"type": "number", "minimum": 0},
        "readiness_gap": {"type": "number", "minimum": 0},
        "coverage_gap": {"type": "number", "minimum": 0},
        "staleness": {"type": "number", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0}
      }
    },
    "canonical_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
