{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/lesson-family.schema.json",
  "title": "Gef multilingual lesson family",
  "type": "object",
  "required": ["schema_version", "lesson_family_id", "lesson_key", "grammar_set_id", "eligibility", "block_plan", "review_state", "version"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "lesson_family_id": {"type": "string", "pattern": "^LES\\.mul\\.[A-Za-z0-9._-]+$"},
    "lesson_key": {"type": "string", "minLength": 1},
    "title_key": {"type": "string", "minLength": 1},
    "fallback_title_en": {"type": "string", "minLength": 1},
    "summary_key": {"type": "string", "minLength": 1},
    "fallback_summary_en": {"type": "string", "minLength": 1},
    "grammar_set_id": {"type": "string", "pattern": "^GRAMSET\\.[A-Za-z0-9._-]+$"},
    "language_capabilities_manifest": {"type": "string", "minLength": 1},
    "comparison_blurb_manifest": {"type": "string", "minLength": 1},
    "curriculum_concept_ids": {"type": "array", "items": {"type": "string", "pattern": "^CURR\\.[A-Za-z0-9._-]+$"}, "uniqueItems": true},
    "transparency_slide": {
      "type": "object",
      "required": ["fixed_comparison_language_tags", "language_loop_order", "dedupe_language_roles", "support_selection"],
      "properties": {
        "description": {"type": "string"},
        "fixed_comparison_language_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "language_loop_order": {"type": "array", "items": {"enum": ["fixed", "learning_from", "learning"]}, "uniqueItems": true},
        "dedupe_language_roles": {"type": "boolean"},
        "rendering_model": {"type": "string"},
        "support_selection": {
          "type": "object",
          "required": ["full", "comparison_only", "unavailable"],
          "properties": {
            "full": {"type": "string", "minLength": 1},
            "comparison_only": {"type": "string", "minLength": 1},
            "unavailable": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "title_policy": {
      "type": "object",
      "required": ["default_display_locale", "template_key", "variables", "forms_source", "language_list_format"],
      "properties": {
        "default_display_locale": {"type": "string", "minLength": 1},
        "template_key": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forms_source": {"type": "string", "minLength": 1},
        "language_list_format": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "required": ["minimum_display_languages", "maximum_display_languages", "require_non_anchor_multi_form_language", "prefer_profile_languages"],
      "properties": {
        "minimum_display_languages": {"type": "integer", "minimum": 1},
        "maximum_display_languages": {"type": "integer", "minimum": 1},
        "require_non_anchor_multi_form_language": {"type": "boolean"},
        "prefer_profile_languages": {"type": "boolean"},
        "fill_with_anchor_language_when_needed": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "block_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "block_type"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "block_type": {"enum": ["lesson_facts", "grammar_primer", "localized_text", "word_examples", "language_comparison_loop", "language_rules", "curated_examples", "practice_intro", "practice", "quest_offer", "completion"]},
          "group_id": {"type": "string"},
          "repeat": {"enum": ["once", "per_single_form_language", "per_multi_form_language", "per_selected_language", "per_relevant_language", "per_full_support_learning_language", "per_form", "per_rule"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "presentation_modes": {
      "type": "array",
      "items": {"enum": ["scroll", "paged", "presentation"]},
      "uniqueItems": true
    },
    "learning_path_policy": {
      "type": "object",
      "properties": {
        "placements_are_language_specific": {"type": "boolean"},
        "placement_registry": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "review_state": {"enum": ["candidate", "approved", "superseded", "rejected"]},
    "version": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
