{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/grammar-set-fragment.schema.json",
  "title": "Gef batched grammar-set research fragment",
  "type": "object",
  "required": ["schema_version", "grammar_set_id", "lesson_family_id", "batch_id", "research_mode", "comparison_basis", "languages", "review_state", "version"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "grammar_set_id": {"type": "string", "pattern": "^GRAMSET\\.[A-Za-z0-9._-]+$"},
    "lesson_family_id": {"type": "string", "pattern": "^LES\\.[A-Za-z0-9._-]+$"},
    "batch_id": {"type": "string", "pattern": "^GRAMBATCH\\.[A-Za-z0-9._-]+$"},
    "research_mode": {"type": "string", "const": "native_explainer_plus_structured_rules"},
    "comparison_basis": {"type": "string", "const": "semantic_functions"},
    "languages": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/language"}},
    "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
    "version": {"type": "integer", "minimum": 1}
  },
  "definitions": {
    "nativeExplainer": {
      "type": "object",
      "required": ["title", "body", "language_tag"],
      "properties": {
        "language_tag": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 40},
        "native_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "summary_en", "tips_en"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^RULE\\.[A-Za-z0-9._-]+$"},
        "summary_en": {"type": "string", "minLength": 1},
        "semantic_function_ids": {"type": "array", "items": {"type": "string", "pattern": "^SEM\\.[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "tips_en": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": ["form_id", "display", "form_kind", "rules"],
      "properties": {
        "form_id": {"type": "string", "pattern": "^GRAMFORM\\.[A-Za-z0-9._-]+$"},
        "display": {"type": "string", "minLength": 1},
        "form_kind": {"type": "string", "enum": ["word", "preposition", "postposition", "case_marker", "particle", "prepositional_phrase", "construction", "clause_marker", "other"]},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/rule"}}
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": ["language_tag", "language_name_en", "classification", "lesson_ready", "native_explainer", "forms", "source_refs", "review_state"],
      "properties": {
        "language_tag": {"type": "string", "minLength": 1},
        "language_name_en": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "enum": ["multi_form", "multi_construction", "single_dominant_form"]},
        "lesson_ready": {"type": "boolean"},
        "native_explainer": {"$ref": "#/definitions/nativeExplainer"},
        "forms": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/form"}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "review_state": {"type": "string", "enum": ["candidate", "approved", "superseded", "rejected"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
