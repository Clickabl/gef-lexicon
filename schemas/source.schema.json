{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gef-lexicon/source.schema.json",
  "title": "GEF Bibliography / Evidence Source Database",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "source_type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src[-_][A-Za-z0-9._:-]+$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "internal_work",
            "book",
            "article",
            "dataset",
            "website",
            "wikipedia",
            "wikidata",
            "archive",
            "film",
            "tv_series",
            "tv_episode",
            "song",
            "poem",
            "play",
            "video_game",
            "speech",
            "advertisement",
            "internet_meme",
            "social_media",
            "release_variant",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "release_date": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "official_url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "parent_source_id": {
          "type": "string",
          "pattern": "^src[-_][A-Za-z0-9._:-]+$"
        },
        "edition_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locale": {
              "type": "string"
            },
            "channel": {
              "type": "string",
              "enum": [
                "original_text",
                "original_dialogue",
                "script",
                "transcript",
                "subtitle",
                "dub",
                "published_translation",
                "caption",
                "other"
              ]
            },
            "platform_or_release": {
              "type": "string"
            }
          }
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "content_source_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_repo",
            "source_path",
            "source_sha256",
            "source_pointer",
            "source_record"
          ],
          "properties": {
            "source_repo": {
              "const": "Clickabl/gef-content"
            },
            "source_path": {
              "type": "string",
              "pattern": "^works/[^/]+/sources\\.json$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_pointer": {
              "type": "string",
              "pattern": "^/sources/[0-9]+$"
            },
            "source_record": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "title",
                "source_kind"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "creator": {
                  "type": "string"
                },
                "publication": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "institution": {
                  "type": "string"
                },
                "identifier": {
                  "type": "string"
                },
                "inspection": {
                  "type": "string"
                },
                "image_rights": {
                  "type": "string"
                },
                "rights_note": {
                  "type": "string"
                },
                "pages": {
                  "type": "string"
                },
                "transcript_url": {
                  "type": "string"
                },
                "transcript_urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "entry_ref": {
                  "type": "string"
                },
                "same_historical_source_as": {
                  "type": "string"
                },
                "relationship_note": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                }
              }
            }
          }
        },
        "source_kind": {
          "type": "string"
        },
        "source_publication": {
          "type": "string"
        },
        "source_date": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "transcript_url": {
          "type": "string"
        },
        "transcript_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
